# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
BUSINESS_NAME=Infinity StockFlow
BUSINESS_INFO_FILE=business_info.md

# --- Base de données ---
# Ny base an'ny logiciel (vakiana fotsiny). Lalana tanteraka ao amin'ny server.
DB_PATH=/chemin/vers/infinity-stockflow.sqlite
# Base manokan'ny agent (tantaran'ny resaka)
HISTORY_DB_PATH=/opt/social-agent/agent_history.sqlite
# Tables azon'ny agent vakiana (sarahina amin'ny faingo). Aza ampidirina ny tables misy mombamomba ny mpanjifa.
SQL_ALLOWED_TABLES=products,categories,faq,shipping_zones
# SQL mamoaka ny kaomandin'ilay mpanjifa miresaka (tsy voatery; jereo social_agent/tools.py)
# Paramètres: :platform :user_id :phone_intl (261341234567) :phone_plus (+261341234567) :phone_local (0341234567)
# CUSTOMER_ORDERS_SQL=SELECT id, status, total, created_at FROM orders WHERE client_phone IN (:phone_local, :phone_plus, :phone_intl) ORDER BY created_at DESC

# --- Meta (iray ihany ny App ho an'ny Facebook sy WhatsApp) ---
META_VERIFY_TOKEN=token-safidinao
META_APP_SECRET=...
META_GRAPH_VERSION=v21.0
# Facebook Page / Instagram
META_PAGE_ACCESS_TOKEN=...
# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...

# --- API ho an'ny ekipa (/admin/...) ---
ADMIN_TOKEN=soloy-teny-miafina-lava
